# Local development only (the deployed values come from stacks/landing/.env on the server).
# Copy to .env and fill in; .env is git-ignored. See README > Development.
LANDING_MIGRATOR_PASSWORD=change-me
LANDING_APP_PASSWORD=change-me
ConnectionStrings__Migrator=Host=127.0.0.1;Port=5432;Database=landing_db;Username=landing_migrator;Password=change-me
ConnectionStrings__App=Host=127.0.0.1;Port=5432;Database=landing_db;Username=landing_app;Password=change-me
